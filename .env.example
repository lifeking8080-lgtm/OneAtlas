# Existing database connections
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
PORT="10000"

# Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY"
# Supabase Authentication user UUID of the one allowed Super Admin
SUPER_ADMIN_USER_ID="YOUR_SUPABASE_AUTH_USER_UUID"

# Free AI Research Assistant (server-side secrets; never prefix with NEXT_PUBLIC_)
# Groq: https://console.groq.com/keys (free tier available)
GROQ_API_KEY="YOUR_GROQ_API_KEY"
GROQ_MODEL=openai/gpt-oss-120b
# LangSearch: https://langsearch.com (free tier available)
LANGSEARCH_API_KEY="YOUR_LANGSEARCH_API_KEY"
